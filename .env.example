# Keep real credentials in your shell or an untracked .env file.
TRAINCTL_TELEGRAM_TOKEN=replace-with-a-bot-token
TRAINCTL_TELEGRAM_ALLOWED_USERS=123456789,987654321

# Optional Discord webhook notifications (outgoing only).
# TRAINCTL_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# Optional overrides
# TRAINCTL_CONFIG=~/.config/trainctl/config.toml
# TRAINCTL_DATABASE=~/.local/share/trainctl/trainctl.db
# TRAINCTL_LOG_DIR=~/.local/share/trainctl/logs
